# URL of the Go backend server. The Next.js dev/prod server proxies
# requests from /api/* to ${BACKEND_URL}/* via next.config.ts rewrites.
BACKEND_URL=http://localhost:8080

# Public URL of the frontend application (for sitemap/robots.txt metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile Site Key (Required at build time for reports captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
