# DarkCopy - Docker Compose Environment
# Copy: cp .env.example .env

# Ports & bind addresses (127.0.0.1 = localhost only, 0.0.0.0 = public)
DB_HOST_PORT=5432
DB_BIND=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_BIND=127.0.0.1
BACKEND_HOST_PORT=8080
BACKEND_BIND=0.0.0.0
FRONTEND_HOST_PORT=3000
FRONTEND_BIND=0.0.0.0

# Redis
REDIS_PASSWORD=example_redis_password_change_me

# PostgreSQL
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password_change_me
POSTGRES_DB=example_db

# Override to use external DB/Redis (defaults to internal compose services)
# DATABASE_URL=postgres://user:pass@external-host:5432/db?sslmode=require
# DATABASE_READ_URL=
# REDIS_URL=redis://:pass@external-redis:6379/0

# Backend
ADMIN_TOKEN=example_admin_token_change_me
CLEANUP_INTERVAL=5m
UPLOAD_DIR=./uploads
UPLOAD_MAX_MEM_MB=32
UPLOAD_MAX_MEM_TOTAL_MB=64
TURNSTILE_SECRET_KEY=

# Single S3 (optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_CUSTOM_DOMAIN=cdn.example.com
# S3_IS_PUBLIC=true

# Multi-S3 (optional, overrides single S3_BUCKET)
# S3_PROVIDERS=BACKBLAZE,CLOUDFLARE
# S3_BACKBLAZE_BUCKET=my-bucket
# S3_BACKBLAZE_REGION=us-east-005
# S3_BACKBLAZE_ENDPOINT=s3.us-east-005.backblazeb2.com
# S3_BACKBLAZE_ACCESS_KEY=your-key
# S3_BACKBLAZE_SECRET_KEY=your-key
# S3_BACKBLAZE_CUSTOM_DOMAIN=cdn.example.com/file/
# S3_BACKBLAZE_IS_PUBLIC=true
# S3_CLOUDFLARE_BUCKET=my-r2-bucket
# S3_CLOUDFLARE_REGION=auto
# S3_CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_CLOUDFLARE_ACCESS_KEY=your-key
# S3_CLOUDFLARE_SECRET_KEY=your-key
# S3_CLOUDFLARE_CUSTOM_DOMAIN=files.example.com
# S3_CLOUDFLARE_IS_PUBLIC=true

# Frontend (build-time args)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_URL=

# Container names (optional)
# DB_CONTAINER_NAME=darkcopy-db
# BACKEND_CONTAINER_NAME=darkcopy-backend
# FRONTEND_CONTAINER_NAME=darkcopy-frontend
# REDIS_CONTAINER_NAME=darkcopy-redis
# DB_BACKUP_CONTAINER_NAME=darkcopy-db-backup