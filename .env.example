# ===========================================
# DarkCopy - Docker Compose Environment Config
# ===========================================
# Copy this file to .env and adjust values:
#   cp .env.example .env


DB_HOST_PORT=5432
# keep DB off the network
DB_BIND=127.0.0.1

REDIS_HOST_PORT=6379
REDIS_BIND=127.0.0.1

BACKEND_HOST_PORT=8080
BACKEND_BIND=0.0.0.0

FRONTEND_HOST_PORT=3000
FRONTEND_BIND=0.0.0.0

# Redis auth password (required; wired into backend REDIS_URL automatically)
REDIS_PASSWORD=example_redis_password_change_me

# PostgreSQL
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password_change_me
POSTGRES_DB=example_db

# -------------------------------------------
# Backend - General
# -------------------------------------------
# Admin API token (X-Admin-Token header). Use a long random value.
ADMIN_TOKEN=example_admin_token_change_me
# How often expired pastes/files are swept (Go duration: 30s, 5m, 1h)
CLEANUP_INTERVAL=5m
# Directory for uploaded files (used when S3 is not configured)
UPLOAD_DIR=./uploads
# Upload memory limits (MB)
UPLOAD_MAX_MEM_MB=32
UPLOAD_MAX_MEM_TOTAL_MB=64
# Cloudflare Turnstile (optional - captcha for reports)
TURNSTILE_SECRET_KEY=

# -------------------------------------------
# Backend - Single S3 Storage (optional)
# If S3_BUCKET is set, files are stored on S3-compatible
# -------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: custom domain for public download URLs
# S3_CUSTOM_DOMAIN=cdn.example.com
# Optional: mark bucket as public (skip presigning)
# S3_IS_PUBLIC=true

# -------------------------------------------
# Backend - Multi-S3 Storage (optional)
# Overrides single S3_BUCKET when set. Register multiple
# S3-compatible providers (comma-separated) to distribute
# uploads and combine free tiers. Each provider needs its
# own S3_<NAME>_* credentials below.
# -------------------------------------------
# S3_PROVIDERS=BACKBLAZE,CLOUDFLARE

# Provider 1: Backblaze B2 example
# S3_BACKBLAZE_BUCKET=my-bucket
# S3_BACKBLAZE_REGION=us-east-005
# S3_BACKBLAZE_ENDPOINT=s3.us-east-005.backblazeb2.com
# S3_BACKBLAZE_ACCESS_KEY=your-access-key
# S3_BACKBLAZE_SECRET_KEY=your-secret-key
# S3_BACKBLAZE_CUSTOM_DOMAIN=cdn.example.com/file/
# S3_BACKBLAZE_IS_PUBLIC=true

# Provider 2: Cloudflare R2 example
# S3_CLOUDFLARE_BUCKET=my-r2-bucket
# S3_CLOUDFLARE_REGION=auto
# S3_CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_CLOUDFLARE_ACCESS_KEY=your-access-key
# S3_CLOUDFLARE_SECRET_KEY=your-secret-key
# S3_CLOUDFLARE_CUSTOM_DOMAIN=files.example.com
# S3_CLOUDFLARE_IS_PUBLIC=true

# -------------------------------------------
# Frontend (build-time args)
# -------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_URL=